# Copy to .env and edit. Never commit .env.
NODE_ENV=development
PORT=3000
DB_PATH=./data/revov.db

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_EXPIRES_IN=8h

MACHINE_ID=RV-014

# Address the CUSTOMER'S PHONE and the payment provider can reach (not localhost for real devices).
# Dev example: your computer's LAN IP, e.g. http://192.168.1.20:3000. Production must be https.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Payments ----
PAYMENT_PROVIDER=mock          # mock | santimpay   (mock is refused when NODE_ENV=production)
MOCK_WEBHOOK_SECRET=replace-with-16-plus-random-chars
# SantimPay (leave empty while using the mock). Values come from SantimPay; UNVERIFIED, see README.
SANTIMPAY_BASE_URL=
SANTIMPAY_MERCHANT_ID=
SANTIMPAY_PRIVATE_KEY=         # PEM on one line with \n escapes. Backend only.

# ---- Dispensing ----
DISPENSER=mock
MOCK_DISPENSE_SCENARIO=ok      # ok | fail-second | fail-all | lost-ack
MOCK_DISPENSE_DELAY_MS=1500

# ---- Timing ----
PAYMENT_WINDOW_SECONDS=600     # after this with no answer the payment becomes UNKNOWN (stock stays held)
UNPAID_HOLD_SECONDS=300        # idle time before stock held by an unpaid order is given back
RECONCILE_INTERVAL_MS=10000

# ---- Seed (used only by `npm run seed`) ----
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
